# Copy to `.env`. Every setting in app/config.py appears here.
# The defaults below run the full pipeline with no network and no API keys.

# --- Database ---------------------------------------------------------------
# PostgreSQL with the `vector` and `pg_trgm` extensions available.
# Inside docker compose the host is `db`; from the host machine it is localhost.
DATABASE_URL=postgresql+psycopg://mtm:mtm@localhost:5432/mtm
# Host port the compose `db` service publishes on. Change both this and the
# port in DATABASE_URL if you already run PostgreSQL on 5432.
DB_PORT=5432

# --- Embeddings -------------------------------------------------------------
# `fake` = deterministic hash-based vectors, no network. `openai_compat` = any
# OpenAI-compatible /embeddings endpoint.
EMBEDDING_PROVIDER=fake
# Recorded on every proposal so a stored result names its vector space.
EMBEDDING_MODEL=fake-hash-v1
# Dimension of the pgvector column. Changing this requires a new migration,
# because pgvector columns are typed with a fixed dimension.
EMBEDDING_DIM=1536
# Base URL for the OpenAI-compatible embeddings endpoint (used when
# EMBEDDING_PROVIDER=openai_compat).
OPENAI_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# API key for the OpenAI-compatible endpoint. Leave empty when using `fake`.
OPENAI_API_KEY=

# --- LLM reranking ----------------------------------------------------------
# `fake` = deterministic reranker (lexical score order), no network.
LLM_PROVIDER=fake
# Recorded on every proposal alongside the prompt hash.
LLM_MODEL=fake-rerank-v1
# Required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Base URL for an OpenAI-compatible /chat/completions endpoint.
OPENAI_CHAT_BASE_URL=https://api.openai.com/v1
# Per-request timeout for the reranking call.
LLM_TIMEOUT_SECONDS=60
# Output token ceiling for the reranking call.
LLM_MAX_OUTPUT_TOKENS=2048

# --- Retrieval --------------------------------------------------------------
# Candidates returned by the lexical stage before merging.
LEXICAL_TOP_K=20
# Candidates returned by the vector stage before merging.
VECTOR_TOP_K=20
# Merged candidate list is truncated to this many before reranking.
RERANK_CANDIDATE_CAP=15
# Minimum pg_trgm word_similarity for a concept to enter the lexical candidate
# set. Lower admits more misspellings and more noise. PostgreSQL's own default
# for this operator is 0.6.
TRIGRAM_THRESHOLD=0.45
# Reciprocal-rank-fusion smoothing constant.
RRF_K=60

# --- Terminology ------------------------------------------------------------
# Version used when a /map request does not name one.
DEFAULT_TERMINOLOGY_VERSION=2026

# --- Service ----------------------------------------------------------------
LOG_LEVEL=INFO
