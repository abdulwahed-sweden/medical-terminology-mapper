# Copy to `.env`. Every setting in app/config.py appears here.
# The defaults below run the full pipeline with no network and no API keys.

# --- Database ---------------------------------------------------------------
# PostgreSQL with the `vector` and `pg_trgm` extensions available.
# Inside docker compose the host is `db`; from the host machine it is localhost.
DATABASE_URL=postgresql+psycopg://mtm:mtm@localhost:5432/mtm
# Host port the compose `db` service publishes on. Change both this and the
# port in DATABASE_URL if you already run PostgreSQL on 5432.
DB_PORT=5432

# --- Embeddings -------------------------------------------------------------
# `fake` = deterministic hash-based vectors, no network. `openai_compat` = any
# OpenAI-compatible /embeddings endpoint.
EMBEDDING_PROVIDER=fake
# Recorded on every proposal so a stored result names its vector space.
EMBEDDING_MODEL=fake-hash-v1
# Dimension of the pgvector column. Changing this requires a new migration,
# because pgvector columns are typed with a fixed dimension.
EMBEDDING_DIM=1536
# Base URL for the OpenAI-compatible embeddings endpoint (used when
# EMBEDDING_PROVIDER=openai_compat).
OPENAI_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# API key for the OpenAI-compatible endpoint. Leave empty when using `fake`.
OPENAI_API_KEY=

# --- LLM reranking ----------------------------------------------------------
# `fake` = deterministic reranker (lexical score order), no network.
LLM_PROVIDER=fake
# Recorded on every proposal alongside the prompt hash.
LLM_MODEL=fake-rerank-v1
# Required when LLM_PROVIDER=anthropic. Set LLM_MODEL to a Claude model id,
# e.g. claude-opus-5.
ANTHROPIC_API_KEY=
# Base URL for an OpenAI-compatible /chat/completions endpoint.
OPENAI_CHAT_BASE_URL=https://api.openai.com/v1
# Per-request timeout for the reranking call.
LLM_TIMEOUT_SECONDS=60
# Output token ceiling for the reranking call. On current Claude models thinking
# tokens count towards this, and a truncated reply cannot be parsed or repaired.
LLM_MAX_OUTPUT_TOKENS=8192
# Reasoning effort for providers that support it: low | medium | high | xhigh | max.
LLM_EFFORT=medium
# Ask the provider to constrain its output to the rerank JSON schema. Set false
# for a model that does not support constrained output; the strict parser, the
# repair retry and the hallucinated-code guard apply either way.
LLM_STRUCTURED_OUTPUT=true

# --- Retrieval --------------------------------------------------------------
# Candidates returned by the lexical stage before merging.
LEXICAL_TOP_K=20
# Candidates returned by the vector stage before merging.
VECTOR_TOP_K=20
# Merged candidate list is truncated to this many before reranking.
RERANK_CANDIDATE_CAP=15
# Minimum pg_trgm word_similarity for a concept to enter the lexical candidate
# set. Lower admits more misspellings and more noise. PostgreSQL's own default
# for this operator is 0.6.
TRIGRAM_THRESHOLD=0.45
# Reciprocal-rank-fusion smoothing constant.
RRF_K=60
# Include the publisher's Beskrivning text in the full-text index, at the lowest
# tsvector weight (D). Measured on the real KVA 2026 release: description-only
# recall 2% -> 48%, with no additional non-clinical word admitted by the gate.
# Changing this requires re-running scripts/embed_terminology.py.
INDEX_DESCRIPTIONS=true

# --- Retrieval gate ---------------------------------------------------------
# Runs after merge and before the LLM. If nothing clears it the proposal is
# recorded as no_good_match and the model is never asked.
# Admit when the best full-text rank exceeds this. 0.0 means "the swedish text
# search configuration matched at least one lexeme".
GATE_MIN_TS_RANK=0.0
# Admit when the best pg_trgm strict_word_similarity reaches this. Covers
# misspellings, which produce no full-text match at all. Measured plateau
# 0.58-0.62; see ARCHITECTURE.md for the data behind 0.60.
GATE_MIN_STRICT_SIMILARITY=0.60
# Normalized queries shorter than this are blocked before any evidence check.
# Three keeps real abbreviations such as AKS and PTCA while stopping noise.
GATE_MIN_QUERY_CHARS=3
# Optional per-vector-space floors as JSON, keyed "provider/model", e.g.
# {"openai_compat/text-embedding-3-small": 0.35}. Empty by default on purpose:
# the fake provider's similarities are hash noise and must never be used to tune
# a threshold. UNTESTED against a live embedding model.
GATE_VECTOR_FLOORS={}

# --- Terminology ------------------------------------------------------------
# Version used when a /map request does not name one.
DEFAULT_TERMINOLOGY_VERSION=2026

# --- Service ----------------------------------------------------------------
LOG_LEVEL=INFO
